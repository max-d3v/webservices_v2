{
  "name": "ts-node-express",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "build": "npx tsc",
    "start-dev": "cross-env NODE_ENV=prd node dist/src/main.js",
    "start": "cross-env NODE_ENV=prd node dist/src/primary-cluster.js",
    "dev": "cross-env NODE_ENV=dev nodemon src/app/main.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "itest-dev": "cross-env NODE_ENV=tst.local jest --config itest.config.ts",
    "itest": "cross-env NODE_ENV=tst jest --config itest.config.ts --detectOpenHandles",
    "quality:complexity": "npx ts-node quality-metrics/complexity-analyzer.ts",
    "quality:performance": "npx ts-node quality-metrics/performance-analyzer.ts",
    "quality:audit": "npx ts-node quality-metrics/quality-auditor.ts",
    "quality:full": "npm run quality:audit",
    "lint": "npx eslint src/**/*.ts",
    "lint:fix": "npx eslint src/**/*.ts --fix",
    "ci:install": "npm ci",
    "ci:build": "npm run build",
    "ci:test": "npm run test:coverage && npm run itest",
    "ci:quality": "npm run quality:audit",
    "ci:security": "npm audit --audit-level=high",
    "ci:lint": "npm run lint",
    "ci:pipeline": "npm run ci:install && npm run ci:lint && npm run ci:test && npm run ci:quality && npm run ci:security && npm run ci:build",
    "docker:build": "docker build -t webservices-node:latest .",
    "docker:run:dev": "docker-compose up -d",
    "docker:run:staging": "docker-compose -f docker-compose.yml -f docker-compose.staging.yml up -d",
    "docker:run:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "deploy:production": "bash scripts/deploy.sh production",
    "monitoring:up": "docker-compose up -d prometheus grafana",
    "monitoring:down": "docker-compose stop prometheus grafana"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.54.0",
    "@opentelemetry/sdk-metrics": "^1.29.0",
    "@opentelemetry/sdk-node": "^0.56.0",
    "@opentelemetry/sdk-trace-node": "^1.29.0",
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.20.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "redis": "^4.7.0",
    "short-uuid": "^5.2.0",
    "winston": "^3.14.2"
  },
  "prisma": {},
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.7.9",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "artillery": "^2.0.21",
    "eslint-plugin-complexity": "^1.0.2",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
